{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "incognito": "not_allowed",
  "name": "Math Study Log",
  "version": "0.1.0",
  "description": "Solve mathematics offline with deterministic, verifiable solvers and keep a study log.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "sidePanel"
  ],
  "action": {
    "default_title": "Math Study Log — Side Panel",
    "default_popup": "panel-launcher.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "commands": {
    "solve-selection-to-clipboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "選択中の数学問題を解いて回答をコピー"
    }
  },
  "options_page": "settings.html"
}
