{
  "manifest_version": 3,
  "name": "Math Study Log",
  "version": "0.1.0",
  "description": "Solve mathematics offline with deterministic, verifiable solvers and keep a study log.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "offscreen"
  ],
  "action": {
    "default_title": "Math Study Log",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "commands": {
    "solve-selection-to-clipboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "選択中の数学問題を解いて回答をコピー"
    }
  },
  "options_page": "settings.html"
}
